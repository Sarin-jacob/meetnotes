{
  "name": "meetnotes",
  "version": "1.0.0",
  "description": "Offline meeting minutes PWA — on-device transcription, diarization and summarisation",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "deploy": "vite build && gh-pages -d dist --nojekyll -m \"Deploy benchmark\""
  },
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@mlc-ai/web-llm": "^0.2.85"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "gh-pages": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "private": true
}
